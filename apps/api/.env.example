# ============================================================
# Application
# ============================================================
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
API_PREFIX=api/v1

# ============================================================
# Database (PostgreSQL via Prisma)
# ============================================================
DATABASE_URL=postgresql://flux:flux_secret@localhost:5432/flux_dev
DATABASE_MAX_CONNECTIONS=20

# ============================================================
# Redis (caching, queues, sessions)
# ============================================================
REDIS_URL=redis://:redis_secret@localhost:6379

# ============================================================
# Authentication — JWT
# Secrets must be cryptographically random strings.
# JWT_SECRET and JWT_REFRESH_SECRET must each be at least 64 characters.
# Generate with: openssl rand -hex 64
# ============================================================
JWT_SECRET=replace_with_a_cryptographically_random_string_of_at_least_64_characters
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=replace_with_a_different_cryptographically_random_string_of_at_least_64_characters
JWT_REFRESH_EXPIRY=7d

# ============================================================
# Encryption
# 32-byte (256-bit) key used for AES-256 field-level encryption.
# Must be exactly 64 hex characters.
# Generate with: openssl rand -hex 32
# ============================================================
ENCRYPTION_KEY=replace_with_64_hex_character_string_generated_by_openssl_rand_hex_32

# ============================================================
# AWS
# ============================================================
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET=flux-dev-uploads
AWS_SES_FROM_EMAIL=no-reply@example.com

# ============================================================
# Stripe — Payments
# Use test-mode keys locally (sk_test_ / pk_test_).
# Webhook secret is generated by the Stripe CLI for local dev:
#   stripe listen --forward-to localhost:3001/api/v1/webhooks/stripe
# ============================================================
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_test_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_signing_secret
STRIPE_STARTER_PRICE_ID=price_replace_with_starter_plan_price_id
STRIPE_PROFESSIONAL_PRICE_ID=price_replace_with_professional_plan_price_id

# ============================================================
# AI Provider
# ============================================================
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-replace_with_your_anthropic_api_key

# ============================================================
# Rate Limiting (per-tenant throttle)
# ============================================================
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT_PER_TENANT=100

# ============================================================
# Monitoring & Error Tracking
# ============================================================
SENTRY_DSN=https://replace@o000000.ingest.sentry.io/0000000
