// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuidOssp(map: "uuid-ossp"), pgcrypto]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TenantStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum PlanType {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum UserRole {
  OWNER
  ADMIN
  FINANCEIRO
  LEITURA
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  RECONCILED
  CANCELLED
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum TaxRegime {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
  MEI
}

enum TaxObligationStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum SupplierCategory {
  SERVICES
  GOODS
  UTILITIES
  RENT
  SALARIES
  TAXES
  FINANCIAL
  OTHER
}

enum InvoiceStatus {
  PENDING_PROCESSING
  PROCESSING
  PROCESSED
  ERROR
  DUPLICATE
  REJECTED
}

enum NotificationType {
  TRANSACTION_DUE
  TRANSACTION_OVERDUE
  INVOICE_PROCESSED
  INVOICE_ERROR
  TAX_OBLIGATION_DUE
  TAX_OBLIGATION_OVERDUE
  PLAN_LIMIT_WARNING
  PLAN_LIMIT_REACHED
  BANK_RECONCILIATION_READY
  INVITE_RECEIVED
  SYSTEM_ANNOUNCEMENT
  AI_INSIGHT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  INVITE_SENT
  INVITE_ACCEPTED
  ROLE_CHANGED
  PLAN_CHANGED
  EXPORT
  BULK_DELETE
  RECONCILE
  TAX_CALCULATION
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  UNPAID
  CANCELLED
  TRIALING
  PAUSED
  INCOMPLETE
  INCOMPLETE_EXPIRED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Tenant {
  id               String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug             String       @unique @db.VarChar(100)
  companyName      String       @db.VarChar(200)
  cnpj             String       @unique @db.VarChar(18)
  email            String       @db.VarChar(254)
  phone            String?      @db.VarChar(20)
  status           TenantStatus @default(ONBOARDING)
  planType         PlanType     @default(FREE)
  taxRegime        TaxRegime?
  fiscalYearStart  Int          @default(1)
  timezone         String       @default("America/Sao_Paulo") @db.VarChar(50)
  locale           String       @default("pt-BR") @db.VarChar(10)
  logoUrl          String?      @db.VarChar(500)
  onboardingStep   Int          @default(0)
  onboardingDone   Boolean      @default(false)
  stripeCustomerId String?      @unique @db.VarChar(100)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  // Relations
  users              UserTenant[]
  invites            Invite[]
  bankAccounts       BankAccount[]
  bankReconciliations BankReconciliation[]
  categories         Category[]
  transactions       Transaction[]
  recurringTemplates RecurringTemplate[]
  suppliers          Supplier[]
  invoices           Invoice[]
  taxObligations     TaxObligation[]
  automationRules    AutomationRule[]
  categorizationRules CategorizationRule[]
  subscription       Subscription?
  notifications      Notification[]
  aiInsights         AiInsight[]
  auditLogs          AuditLog[]

  @@index([status])
  @@index([planType])
  @@map("tenants")
}

model User {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email            String    @unique @db.VarChar(254)
  passwordHash     String    @db.VarChar(72)
  firstName        String    @db.VarChar(100)
  lastName         String    @db.VarChar(100)
  avatarUrl        String?   @db.VarChar(500)
  emailVerified    Boolean   @default(false)
  emailVerifyToken String?   @db.VarChar(200)
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  // Relations
  tenants        UserTenant[]
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  transactions   Transaction[]  @relation("TransactionCreatedBy")
  notifications  Notification[]

  @@index([email])
  @@map("users")
}

model UserTenant {
  id       String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId   String     @db.Uuid
  tenantId String     @db.Uuid
  role     UserRole   @default(FINANCEIRO)
  status   UserStatus @default(ACTIVE)
  joinedAt DateTime   @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@map("user_tenants")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @db.VarChar(200)
  tenantId  String    @db.Uuid
  userAgent String?   @db.VarChar(500)
  ipAddress String?   @db.VarChar(45)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("refresh_tokens")
}

model Invite {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId    String    @db.Uuid
  email       String    @db.VarChar(254)
  role        UserRole  @default(FINANCEIRO)
  token       String    @unique @db.VarChar(200)
  invitedById String    @db.Uuid
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
  @@map("invites")
}

model BankAccount {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId       String    @db.Uuid
  name           String    @db.VarChar(200)
  bankCode       String?   @db.VarChar(10)
  bankName       String?   @db.VarChar(100)
  agency         String?   @db.VarChar(20)
  accountNumber  String?   @db.VarChar(30)
  accountType    String?   @db.VarChar(50)
  currentBalance Decimal   @default(0) @db.Decimal(15, 2)
  initialBalance Decimal   @default(0) @db.Decimal(15, 2)
  currency       String    @default("BRL") @db.VarChar(3)
  isDefault      Boolean   @default(false)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Relations
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions     Transaction[]
  reconciliations  BankReconciliation[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("bank_accounts")
}

model BankReconciliation {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId         String    @db.Uuid
  bankAccountId    String    @db.Uuid
  statementDate    DateTime  @db.Date
  statementBalance Decimal   @db.Decimal(15, 2)
  systemBalance    Decimal   @db.Decimal(15, 2)
  difference       Decimal   @db.Decimal(15, 2)
  isReconciled     Boolean   @default(false)
  reconciledAt     DateTime?
  createdAt        DateTime  @default(now())

  // Relations
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([bankAccountId])
  @@index([tenantId, statementDate])
  @@map("bank_reconciliations")
}

model Category {
  id       String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId String?         @db.Uuid
  name     String          @db.VarChar(100)
  type     TransactionType
  color    String?         @db.VarChar(7)
  icon     String?         @db.VarChar(50)
  parentId String?         @db.Uuid
  isSystem Boolean         @default(false)
  isActive Boolean         @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // Self-relation for hierarchy
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  // Relations
  tenant             Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions       Transaction[]
  recurringTemplates RecurringTemplate[]
  taxMappings        TaxCategoryMapping[]
  categorizationRules CategorizationRule[]

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([isSystem])
  @@map("categories")
}

model Transaction {
  id                  String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId            String            @db.Uuid
  bankAccountId       String?           @db.Uuid
  categoryId          String?           @db.Uuid
  supplierId          String?           @db.Uuid
  invoiceId           String?           @db.Uuid
  recurringTemplateId String?           @db.Uuid
  createdById         String            @db.Uuid
  type                TransactionType
  status              TransactionStatus @default(PENDING)
  amount              Decimal           @db.Decimal(15, 2)
  description         String            @db.VarChar(500)
  notes               String?           @db.VarChar(2000)
  dueDate             DateTime          @db.Date
  paidAt              DateTime?
  competenceDate      DateTime          @db.Date
  tags                String[]          @default([])
  attachmentUrl       String?           @db.VarChar(500)
  externalRef         String?           @db.VarChar(200)
  isRecurring         Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?

  // Relations
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bankAccount       BankAccount?       @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  category          Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier          Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  invoice           Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  recurringTemplate RecurringTemplate? @relation(fields: [recurringTemplateId], references: [id], onDelete: SetNull)
  createdBy         User               @relation("TransactionCreatedBy", fields: [createdById], references: [id])
  taxObligations    TaxObligation[]

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([tenantId, categoryId])
  @@index([bankAccountId])
  @@map("transactions")
}

model RecurringTemplate {
  id              String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId        String              @db.Uuid
  categoryId      String?             @db.Uuid
  supplierId      String?             @db.Uuid
  type            TransactionType
  amount          Decimal             @db.Decimal(15, 2)
  description     String              @db.VarChar(500)
  frequency       RecurrenceFrequency
  dayOfMonth      Int?
  startDate       DateTime            @db.Date
  endDate         DateTime?           @db.Date
  lastGeneratedAt DateTime?
  nextDueDate     DateTime?           @db.Date
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // Relations
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier     Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([tenantId])
  @@index([nextDueDate, isActive])
  @@map("recurring_templates")
}

model Supplier {
  id              String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId        String           @db.Uuid
  name            String           @db.VarChar(200)
  tradeName       String?          @db.VarChar(200)
  cnpj            String?          @db.VarChar(18)
  cpf             String?          @db.VarChar(14)
  email           String?          @db.VarChar(254)
  phone           String?          @db.VarChar(20)
  website         String?          @db.VarChar(500)
  category        SupplierCategory @default(OTHER)
  status          SupplierStatus   @default(ACTIVE)
  address         Json?
  bankDetails     Json?
  totalPaid       Decimal          @default(0) @db.Decimal(15, 2)
  paymentTermDays Int              @default(30)
  notes           String?          @db.VarChar(2000)
  tags            String[]         @default([])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  // Relations
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions       Transaction[]
  recurringTemplates RecurringTemplate[]
  invoices           Invoice[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([cnpj])
  @@map("suppliers")
}

model Invoice {
  id              String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId        String        @db.Uuid
  supplierId      String?       @db.Uuid
  status          InvoiceStatus @default(PENDING_PROCESSING)
  fileType        String        @db.VarChar(10)
  originalFileName String       @db.VarChar(500)
  s3Key           String        @db.VarChar(500)
  s3Bucket        String        @db.VarChar(200)
  fileHash        String        @db.VarChar(64)
  parsedData      Json?
  nfeAccessKey    String?       @db.VarChar(44)
  nfeNumber       String?       @db.VarChar(20)
  nfeSeries       String?       @db.VarChar(5)
  issuerCnpj      String?       @db.VarChar(18)
  issuerName      String?       @db.VarChar(200)
  totalValue      Decimal?      @db.Decimal(15, 2)
  taxValue        Decimal?      @db.Decimal(15, 2)
  issuedAt        DateTime?
  processingError String?       @db.VarChar(2000)
  processedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier     Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@unique([fileHash, tenantId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([nfeAccessKey])
  @@map("invoices")
}

model TaxObligation {
  id               String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId         String              @db.Uuid
  taxName          String              @db.VarChar(100)
  taxCode          String              @db.VarChar(20)
  regime           TaxRegime
  referenceMonth   Int
  referenceYear    Int
  baseAmount       Decimal             @db.Decimal(15, 2)
  rate             Decimal             @db.Decimal(8, 4)
  calculatedAmount Decimal             @db.Decimal(15, 2)
  fineAmount       Decimal             @default(0) @db.Decimal(15, 2)
  interestAmount   Decimal             @default(0) @db.Decimal(15, 2)
  totalAmount      Decimal             @db.Decimal(15, 2)
  dueDate          DateTime            @db.Date
  status           TaxObligationStatus @default(PENDING)
  paidAt           DateTime?
  paymentProofUrl  String?             @db.VarChar(500)
  transactionId    String?             @db.Uuid
  notes            String?             @db.VarChar(2000)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  // Relations
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([dueDate, status])
  @@map("tax_obligations")
}

model TaxCategoryMapping {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  categoryId   String   @db.Uuid
  taxCode      String   @db.VarChar(20)
  isDeductible Boolean  @default(false)
  percentage   Decimal? @db.Decimal(8, 4)

  // Relations
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([taxCode])
  @@map("tax_category_mappings")
}

model AutomationRule {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId     String   @db.Uuid
  name         String   @db.VarChar(200)
  isActive     Boolean  @default(true)
  priority     Int      @default(0)
  conditions   Json
  actions      Json
  appliedCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@map("automation_rules")
}

model CategorizationRule {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId   String?  @db.Uuid
  pattern    String   @db.VarChar(500)
  categoryId String   @db.Uuid
  confidence Decimal  @default(1.0) @db.Decimal(5, 4)
  matchCount Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  // Relations
  tenant   Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([categoryId])
  @@map("categorization_rules")
}

model Subscription {
  id                   String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId             String             @unique @db.Uuid
  stripeSubscriptionId String?            @unique @db.VarChar(100)
  stripePriceId        String?            @db.VarChar(100)
  planType             PlanType
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  trialEnd             DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model StripeWebhookEvent {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  stripeEventId String    @unique @db.VarChar(100)
  type          String    @db.VarChar(100)
  payload       Json
  processedAt   DateTime?
  error         String?   @db.VarChar(2000)
  createdAt     DateTime  @default(now())

  @@index([type])
  @@index([processedAt])
  @@map("stripe_webhook_events")
}

model Notification {
  id           String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId     String           @db.Uuid
  userId       String?          @db.Uuid
  type         NotificationType
  title        String           @db.VarChar(200)
  body         String           @db.VarChar(2000)
  data         Json?
  readAt       DateTime?
  emailSentAt  DateTime?
  createdAt    DateTime         @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, readAt])
  @@index([userId])
  @@map("notifications")
}

model AiInsight {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId    String    @db.Uuid
  type        String    @db.VarChar(100)
  title       String    @db.VarChar(200)
  body        String    @db.VarChar(5000)
  data        Json?
  priority    Int       @default(0)
  isRead      Boolean   @default(false)
  dismissedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isRead])
  @@map("ai_insights")
}

model AuditLog {
  id         String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId   String      @db.Uuid
  userId     String?     @db.Uuid
  action     AuditAction
  resource   String      @db.VarChar(100)
  resourceId String?     @db.VarChar(100)
  oldValue   Json?
  newValue   Json?
  ipAddress  String?     @db.VarChar(45)
  userAgent  String?     @db.VarChar(500)
  createdAt  DateTime    @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, resource])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
